# Copy this file to .env and fill in only the values you intend to use.
# Never commit .env or paste a real API key into source control.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash
AI_PROVIDER=rule_based

# Optional hosted Ollama API mode. Leave OLLAMA_BASE_URL unset for local Ollama.
# OLLAMA_BASE_URL=https://ollama.com/api
# OLLAMA_API_KEY=your_ollama_api_key_here
# OLLAMA_MODEL=gpt-oss:20b

# Optional local paths; use project-relative paths when running from the repo root.
# TRACKER_DB_PATH=compliance_db/tracker.sqlite3
# REGULATION_DIR=data/regulations
